<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.module.category" id="module_category_home_library">
        <field name="name">Home Library</field>
    </record>

    <record id="group_home_library_user" model="res.groups">
        <field name="name">Home Library User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="category_id" ref="module_category_home_library" />
    </record>

    <record id="group_home_library_manager" model="res.groups">
        <field name="name">Home Library Manager</field>
        <field
            name="implied_ids"
            eval="[(4, ref('home_library.group_home_library_user'))]"
        />
        <field name="category_id" ref="module_category_home_library" />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>

    <record id="library_book_comp_rule" model="ir.rule">
        <field name="name">Library Book: multi-company</field>
        <field name="model_id" ref="model_library_book" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="library_author_comp_rule" model="ir.rule">
        <field name="name">Library Author: multi-company</field>
        <field name="model_id" ref="model_library_author" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="library_editorial_comp_rule" model="ir.rule">
        <field name="name">Library Editorial: multi-company</field>
        <field name="model_id" ref="model_library_editorial" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="library_genre_comp_rule" model="ir.rule">
        <field name="name">Library Genre: multi-company</field>
        <field name="model_id" ref="model_library_genre" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
