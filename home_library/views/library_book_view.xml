<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="library_book_view_tree" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="author_id" />
                <field name="name" />
                <field name="editorial_id" optional="show" />
                <field name="collection" optional="show" />
                <field name="city" optional="show" />
                <field name="year" optional="show" />
                <field name="edition" optional="show" />
                <field name="page_total" optional="show" />
                <field name="genre_id" />
                <field
                    name="tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    optional="show"
                />
                <field name="registry_number" optional="show" />
                <field name="language" optional="hide" />
                <field name="udc" optional="hide" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                />
            </list>
        </field>
    </record>

    <record id="library_book_view_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Book Title..." />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="author_id" />
                            <field name="genre_id" />
                            <field
                                name="tag_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color'}"
                            />
                            <field name="editorial_id" />
                            <field name="collection" />
                            <field name="edition" />
                        </group>
                        <group>
                            <field name="city" />
                            <field name="year" />
                            <field name="page_total" />
                            <field name="registry_number" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <group string="Classification" name="classification">
                        <group>
                            <field name="language" />
                            <field name="udc" />
                        </group>
                        <group>
                            <field name="original_title" />
                            <field name="original_language" />
                        </group>
                    </group>
                    <group>
                        <field name="description" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="library_book_view_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="author_id" />
                <field name="editorial_id" />
                <field name="collection" />
                <field name="city" />
                <field name="year" />
                <field name="edition" />
                <field name="genre_id" />
                <field name="tag_ids" />
                <field name="udc" />
                <field name="original_title" />
                <field name="registry_number" />
                <field name="company_id" groups="base.group_multi_company" />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_author"
                        string="Author"
                        domain="[]"
                        context="{'group_by':'author_id'}"
                    />
                    <filter
                        name="group_by_genre"
                        string="Genre"
                        context="{'group_by': 'genre_id'}"
                    />
                    <filter
                        name="group_by_language"
                        string="Language"
                        context="{'group_by': 'language'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="library_book_action">
        <field name="name">Library Book</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="parent_menu_home_library"
        name="Home Library"
        web_icon="home_library,static/description/icon.png"
        groups="group_home_library_user"
    />

    <menuitem
        id="menu_home_library_catalog"
        name="Catalog"
        parent="parent_menu_home_library"
        sequence="10"
    />

    <menuitem
        id="menu_library_book"
        name="Books"
        parent="menu_home_library_catalog"
        action="library_book_action"
        sequence="10"
    />

    <menuitem
        id="menu_home_library_data"
        name="Configuration"
        parent="parent_menu_home_library"
        groups="group_home_library_manager"
        sequence="100"
    />
</odoo>
