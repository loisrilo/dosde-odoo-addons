<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="library_author_view_tree" model="ir.ui.view">
        <field name="name">library.author.list</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                />
            </list>
        </field>
    </record>

    <record id="library_author_view_form" model="ir.ui.view">
        <field name="name">library.author.form</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name..." />
                        </h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="description" />
                    </group>
                    <notebook>
                        <page name="books" string="Books">
                            <field name="book_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_author_view_search" model="ir.ui.view">
        <field name="name">library.author.search</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="library_author_action">
        <field name="name">Authors</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">library.author</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_library_author"
        name="Authors"
        parent="menu_home_library_catalog"
        action="library_author_action"
        sequence="30"
    />
</odoo>
