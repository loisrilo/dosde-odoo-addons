<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="money_item_view_tree" model="ir.ui.view">
        <field name="name">money.item.list</field>
        <field name="model">money.item</field>
        <field name="arch" type="xml">
            <list expand="1">
                <field name="pot_id" />
                <field name="user_id" />
                <field name="amount" />
                <field name="date" />
            </list>
        </field>
    </record>

    <record id="money_item_view_form" model="ir.ui.view">
        <field name="name">money.item.form</field>
        <field name="model">money.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="amount" />
                            <field name="description" />
                            <field name="date" />
                        </group>
                        <group>
                            <field name="user_id" />
                            <field name="pot_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="money_item_view_pivot" model="ir.ui.view">
        <field name="name">money.item.pivot</field>
        <field name="model">money.item</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="user_id" type="row" />
                <field name="date" interval="month" type="col" />
                <field name="amount" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="money_item_view_search" model="ir.ui.view">
        <field name="name">money.item.search</field>
        <field name="model">money.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id" />
                <field name="pot_id" />
                <filter
                    name="filter_open_pot"
                    string="Open Pot"
                    domain="[('pot_id.state', '=', 'open')]"
                />
                <separator />
                <filter name="filter_date" string="Date" date="date" />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_user"
                        string="User"
                        domain="[]"
                        context="{'group_by':'user_id'}"
                    />
                    <filter
                        name="group_by_pot"
                        string="Pot"
                        domain="[]"
                        context="{'group_by':'pot_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="money_item_action">
        <field name="name">Money Item</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">money.item</field>
        <field name="view_mode">list,form,pivot</field>
        <field
            name="context"
        >{'search_default_filter_open_pot': 1, 'search_default_group_by_pot': 1}</field>
    </record>

    <menuitem
        id="menu_money_item"
        name="Money Items"
        parent="parent_menu_money_pot"
        action="money_item_action"
        sequence="20"
    />
</odoo>
